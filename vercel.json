{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd revista-teen-v2 && npm install && npm run build",
  "outputDirectory": "revista-teen-v2/dist",
  "installCommand": "echo 'dependencias sao instaladas dentro de revista-teen-v2 pelo buildCommand'",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
