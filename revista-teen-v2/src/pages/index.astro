---
/**
 * HOME - "A capa da revista".
 *
 * Nada aqui é escrito à mão: hero, destaques, "Em Alta" e "Últimas" saem do score
 * editorial calculado em src/lib/content.ts. Cada matéria aparece no máximo uma vez
 * na página - as listas são construídas descontando o que já foi usado.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import {
  heroArticle,
  featuredArticles,
  trendingArticles,
  latestArticles,
  categories,
  edition,
} from "@/lib/content";

const description =
  "Games, Copa do Mundo 2026, música, cultura pop e tecnologia. A " +
  edition.name +
  " da Revista Teen, com " +
  edition.totalArticles +
  " matérias para quem tem de 14 a 24 anos.";
---

<BaseLayout
  title="Revista Teen | Edição 2026"
  description={description}
  image={heroArticle.image.src}
  imageAlt={heroArticle.image.alt}
>
  <!-- ═══ HERO DE MARCA ═══ -->
  <section
    class="relative flex min-h-[320px] items-center justify-center overflow-hidden py-16 sm:min-h-[380px]"
    style="background: radial-gradient(circle at 50% 30%, rgba(75,107,255,.18), transparent 60%), var(--bg-primary)"
  >
    <div class="container-rt flex flex-col items-center text-center">
      <img
        src="/images/brand/logo.png"
        alt="Revista Teen"
        class="h-24 w-auto sm:h-32"
        width="525"
        height="267"
        fetchpriority="high"
        decoding="sync"
      />
      <p class="type-body mt-6 max-w-xl" style="color: var(--text-secondary)">
        {edition.name} · {edition.totalArticles} matérias para quem tem de 14 a 24 anos
      </p>
    </div>
  </section>

  <!-- ═══ DESTAQUES ═══ -->
  <div class="star-separator" aria-hidden="true"><span class="star">✦</span></div>

  <section class="container-rt" aria-labelledby="destaques">
    <h2 id="destaques" class="sr-only">Destaques da edição</h2>
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
      <div class="reveal lg:col-span-8">
        <ArticleCard article={heroArticle} variant="lead" headingLevel={1} />
      </div>
      <div class="flex flex-col gap-6 lg:col-span-4">
        {featuredArticles.slice(0, 2).map((a) => (
          <div class="reveal">
            <ArticleCard article={a} variant="compact" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ EDITORIAS ═══ -->
  <div class="star-separator" aria-hidden="true"><span class="star">✦</span></div>

  <section class="container-rt" aria-labelledby="editorias">
    <h2 id="editorias" class="type-overline mb-6" style="color: var(--text-muted)">Explore por editoria</h2>
    <ul class="flex flex-wrap gap-x-6 gap-y-3">
      {
        categories.map((cat) => (
          <li>
            <a
              href={cat.href}
              class="underline-grow type-subheading inline-flex items-center gap-2 py-1 transition-colors hover:text-[var(--text-primary)]"
              style="color: var(--text-secondary)"
            >
              <span class="h-2 w-2 shrink-0 rounded-full" style={`background:${cat.color}`} aria-hidden="true" />
              {cat.emoji} {cat.name}
              <span class="type-caption" style="color: var(--text-muted)">{cat.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ═══ EM ALTA ═══ -->
  <div class="star-separator" aria-hidden="true"><span class="star">✦</span></div>

  <section class="container-rt" aria-labelledby="em-alta">
    <div class="mb-8 flex items-center justify-between gap-4">
      <h2 id="em-alta" class="type-display-lg" style="color: var(--text-primary)">Em Alta</h2>
      <a href="/artigos" class="underline-grow type-body-sm" style="color: var(--accent-blue)">Ver todos →</a>
    </div>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {trendingArticles.map((a) => (
        <div class="reveal">
          <ArticleCard article={a} />
        </div>
      ))}
    </div>
  </section>

  <!-- ═══ ÚLTIMAS ═══ -->
  <div class="star-separator" aria-hidden="true"><span class="star">✦</span></div>

  <section class="container-rt pb-12" aria-labelledby="ultimas">
    <div class="mb-8 flex items-center justify-between gap-4">
      <h2 id="ultimas" class="type-display-lg" style="color: var(--text-primary)">Últimas Matérias</h2>
      <a href="/artigos" class="underline-grow type-body-sm" style="color: var(--accent-blue)">Ver todos →</a>
    </div>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {latestArticles.map((a) => (
        <div class="reveal">
          <ArticleCard article={a} />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
