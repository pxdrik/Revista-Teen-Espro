---
/**
 * MATÉRIA - página de leitura.
 *
 * Uma página estática por artigo, gerada no build. Título, descrição, canonical,
 * Open Graph, Twitter Card e JSON-LD saem prontos no HTML, com valores próprios
 * de cada matéria.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CategoryBadge from "@/components/CategoryBadge.astro";
import { articles, getRelated, formatDate } from "@/lib/content";
import type { Article } from "@/lib/schema";

export async function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const related = getRelated(article, 3);
const shareUrl = new URL(article.href, Astro.site).href;
const shareText = article.title;
---

<BaseLayout
  title={article.title + " | Revista Teen"}
  description={article.excerpt}
  image={article.image.src}
  imageAlt={article.image.alt}
  type="article"
  publishedAt={article.publishedAt}
  author={article.author.name}
  section={article.categoryRef.name}
  tags={article.tags}
>
  <div class="reading-progress" data-progress role="presentation"></div>

  <!-- ═══ IMAGEM DE ABERTURA ═══ -->
  <figure class="relative m-0 min-h-[380px] h-[58vh] overflow-hidden">
    <img
      src={article.image.src}
      alt={article.image.alt}
      class="absolute inset-0 h-full w-full object-cover"
      width="1600"
      height="900"
      fetchpriority="high"
      decoding="sync"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to top, #08080D 10%, rgba(8,8,13,.45) 60%, transparent 100%)"></div>
    <figcaption class="container-rt absolute inset-x-0 bottom-2">
      <span class="type-caption" style="color: var(--text-muted)">Foto: {article.image.credit}</span>
    </figcaption>
  </figure>

  <div class="container-rt relative z-10 -mt-24 pb-24">
    <div class="mx-auto max-w-[720px]">
      <Breadcrumb
        items={[
          { label: "Home", href: "/" },
          { label: "Artigos", href: "/artigos" },
          { label: article.categoryRef.name, href: article.categoryRef.href },
          { label: article.title },
        ]}
      />

      <div class="mt-6">
        <CategoryBadge category={article.categoryRef} asLink />
      </div>

      <h1 class="type-display-xl mb-4 mt-4" style="color: var(--text-primary)">{article.title}</h1>

      <p class="type-body mb-8 text-lg leading-relaxed" style="color: var(--text-secondary)">
        {article.subtitle}
      </p>

      <!-- ═══ ASSINATURA + COMPARTILHAMENTO ═══ -->
      <div
        class="mb-10 flex flex-wrap items-center justify-between gap-4 border-y py-6"
        style="border-color: var(--border-subtle)"
      >
        <div class="flex items-center gap-4">
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full font-display font-bold"
            style="background: var(--bg-elevated); color: var(--accent-blue)"
            aria-hidden="true"
          >
            {article.author.name.charAt(0)}
          </span>
          <div>
            <p class="type-body-sm font-medium" style="color: var(--text-primary)">{article.author.name}</p>
            <p class="type-caption" style="color: var(--text-muted)">{article.author.role}</p>
            <p class="type-caption" style="color: var(--text-muted)">
              <time datetime={article.publishedAt}>{formatDate(article.publishedAt, "long")}</time>
              <span aria-hidden="true"> · </span>
              {article.readingTime} min de leitura
            </p>
          </div>
        </div>

        <div class="flex items-center gap-1">
          <a
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(shareText + " " + shareUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg p-2 transition-colors hover:bg-[var(--bg-elevated)]"
            style="color: var(--text-muted)"
            aria-label="Compartilhar no WhatsApp"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2m5.8 14.16c-.24.68-1.2 1.26-1.97 1.42-.53.11-1.21.2-3.51-.75-2.95-1.22-4.85-4.21-5-4.41-.14-.2-1.19-1.58-1.19-3.02s.75-2.14 1.02-2.44c.27-.29.58-.37.78-.37h.56c.18 0 .42-.07.66.5.24.59.83 2.03.9 2.18.07.14.12.31.02.51-.1.2-.15.32-.3.49-.15.17-.31.38-.44.51-.15.14-.3.3-.13.59.17.29.76 1.25 1.63 2.03 1.12 1 2.06 1.31 2.35 1.46.29.15.46.12.63-.07.17-.2.73-.85.93-1.14.19-.29.39-.24.65-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.13.07.73-.17 1.41"></path>
            </svg>
          </a>
          <a
            href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(shareText)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg p-2 transition-colors hover:bg-[var(--bg-elevated)]"
            style="color: var(--text-muted)"
            aria-label="Compartilhar no Twitter/X"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.9 2H22l-7 8 8.2 12h-6.4l-5-7.3L5.9 22H2.8l7.5-8.6L2.4 2h6.6l4.5 6.7zm-1.1 18h1.7L7.3 3.8H5.5z"></path>
            </svg>
          </a>
          <button
            type="button"
            class="rounded-lg p-2 transition-colors hover:bg-[var(--bg-elevated)]"
            style="color: var(--text-muted)"
            aria-label="Copiar link da matéria"
            data-copy-link
            data-url={shareUrl}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.5 1.5"></path>
              <path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.5-1.5"></path>
            </svg>
          </button>
          <span class="type-caption" role="status" aria-live="polite" data-copy-status style="color: var(--accent-blue)"></span>
        </div>
      </div>

      <!-- ═══ CORPO ═══ -->
      <div class="prose-editorial">
        {article.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <!-- ═══ TAGS ═══ -->
      <div class="mt-12">
        <h2 class="type-overline mb-3" style="color: var(--text-muted)">Assuntos</h2>
        <ul class="flex flex-wrap gap-2">
          {
            article.tags.map((tag) => (
              <li
                class="type-caption rounded-full px-3 py-1.5"
                style="background: var(--bg-elevated); color: var(--text-secondary)"
              >
                {tag}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="star-separator" aria-hidden="true"><span class="star">✦</span></div>

      <!-- ═══ RELACIONADOS ═══ -->
      {
        related.length > 0 && (
          <section aria-labelledby="relacionados">
            <h2 id="relacionados" class="type-display-md mb-8" style="color: var(--text-primary)">
              Leia também
            </h2>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
              {related.map((r) => (
                <ArticleCard article={r} variant="compact" />
              ))}
            </div>
          </section>
        )
      }
    </div>
  </div>
</BaseLayout>

<script>
  // Barra de progresso de leitura - passiva, sem custo perceptível.
  const bar = document.querySelector<HTMLElement>("[data-progress]");
  if (bar) {
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const pct = max > 0 ? Math.min(100, Math.max(0, (window.scrollY / max) * 100)) : 0;
      bar.style.width = pct + "%";
    };
    window.addEventListener("scroll", update, { passive: true });
    update();
  }

  // Copiar link
  const btn = document.querySelector<HTMLButtonElement>("[data-copy-link]");
  const status = document.querySelector<HTMLElement>("[data-copy-status]");
  btn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.url ?? window.location.href);
      if (status) {
        status.textContent = "Link copiado!";
        setTimeout(() => (status.textContent = ""), 2500);
      }
    } catch {
      if (status) status.textContent = "Não foi possível copiar";
    }
  });
</script>
