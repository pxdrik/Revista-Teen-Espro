---
/**
 * EDITORIA - uma página estática por categoria.
 *
 * As rotas são geradas a partir da taxonomia derivada dos artigos. É impossível
 * existir página de categoria vazia (o content layer derruba o build se uma
 * categoria declarada não tiver matérias) e impossível existir categoria sem
 * página (todas vêm da mesma lista).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { categories, getArticlesByCategory } from "@/lib/content";
import type { Article, Category } from "@/lib/schema";

export async function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category, items: getArticlesByCategory(category.slug) },
  }));
}

interface Props {
  category: Category;
  items: Article[];
}

const { category, items } = Astro.props;
const others = categories.filter((c) => c.slug !== category.slug);
---

<BaseLayout
  title={category.name + " | Revista Teen"}
  description={"Todas as " + items.length + " matérias de " + category.name + " na Edição 2026 da Revista Teen."}
  image={items[0]?.image.src}
  imageAlt={items[0]?.image.alt}
>
  <div class="container-rt pb-12 pt-8">
    <Breadcrumb
      items={[{ label: "Home", href: "/" }, { label: "Artigos", href: "/artigos" }, { label: category.name }]}
    />

    <header class="mb-8 mt-4">
      <div class="flex items-center gap-3">
        <span class="h-8 w-1 rounded-full" style={`background:${category.color}`} aria-hidden="true"></span>
        <h1 class="type-display-lg" style="color: var(--text-primary)">
          <span aria-hidden="true">{category.emoji}</span> {category.name}
        </h1>
      </div>
      <p class="type-body-sm mt-2" style="color: var(--text-muted)">
        {items.length} {items.length === 1 ? "matéria nesta editoria" : "matérias nesta editoria"}
      </p>
    </header>

    <div class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((article, i) => (
        <ArticleCard article={article} priority={i < 3} headingLevel={2} />
      ))}
    </div>

    <div class="star-separator" aria-hidden="true"><span class="star">✦</span></div>

    <nav aria-labelledby="outras-editorias">
      <h2 id="outras-editorias" class="type-overline mb-4" style="color: var(--text-muted)">Outras editorias</h2>
      <ul class="flex flex-wrap gap-2 sm:gap-3">
        {
          others.map((cat) => (
            <li>
              <a
                href={cat.href}
                class="type-caption inline-flex items-center gap-2 rounded-full px-4 py-2 transition-colors hover:text-[var(--text-primary)]"
                style="background: var(--bg-elevated); color: var(--text-secondary)"
              >
                <span class="h-2 w-2 shrink-0 rounded-full" style={`background:${cat.color}`} aria-hidden="true" />
                {cat.name} ({cat.count})
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</BaseLayout>
