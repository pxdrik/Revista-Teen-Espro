---
/**
 * BUSCA.
 *
 * Todos os cards são renderizados no servidor e filtrados no cliente escondendo os
 * que não batem. O contador NÃO é calculado à parte: ele é o resultado do mesmo
 * laço que mostra/esconde os cards. Por construção, "X matérias encontradas"
 * sempre corresponde a exatamente X cards visíveis - a divergência da V1 fica
 * estruturalmente impossível.
 *
 * Sem JavaScript, a página mostra a edição inteira com o total correto.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { articles, categories, normalize, edition } from "@/lib/content";

// A chave de busca cobre exatamente o prometido: título, subtítulo, resumo,
// categoria e tags (+ autor, útil na redação).
const docs = articles.map((a) => ({
  article: a,
  haystack: normalize([a.title, a.subtitle, a.excerpt, a.categoryRef.name, a.tags.join(" "), a.author.name].join(" ")),
}));
---

<BaseLayout
  title="Buscar | Revista Teen"
  description={"Busque entre as " + edition.totalArticles + " matérias da Edição 2026 da Revista Teen por título, editoria ou assunto."}
>
  <div class="container-rt pb-24 pt-8">
    <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Busca" }]} />

    <header class="mb-8 mt-4">
      <h1 class="type-display-lg" style="color: var(--text-primary)">Buscar na edição</h1>
      <p class="type-body-sm mt-2" style="color: var(--text-muted)">
        Procure por título, subtítulo, resumo, editoria ou assunto.
      </p>
    </header>

    <form class="mb-6 flex flex-col gap-3 sm:flex-row" role="search" data-search-form>
      <div class="relative flex-1">
        <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2" style="color: var(--text-muted)" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path>
          </svg>
        </span>
        <label for="q" class="sr-only">Buscar matérias</label>
        <input
          id="q"
          name="q"
          type="search"
          placeholder="Ex.: Copa, Minecraft, K-pop, inteligência artificial..."
          autocomplete="off"
          class="type-body-sm w-full rounded-full border py-3 pl-11 pr-4 outline-none transition-colors focus:border-[var(--accent-blue)]"
          style="background: var(--bg-surface); border-color: var(--border-subtle); color: var(--text-primary)"
          data-search-input
        />
      </div>

      <label for="cat" class="sr-only">Filtrar por editoria</label>
      <select
        id="cat"
        name="categoria"
        class="type-body-sm rounded-full border px-4 py-3 outline-none transition-colors focus:border-[var(--accent-blue)]"
        style="background: var(--bg-surface); border-color: var(--border-subtle); color: var(--text-secondary)"
        data-search-category
      >
        <option value="">Todas as editorias</option>
        {categories.map((cat) => <option value={cat.slug}>{cat.name} ({cat.count})</option>)}
      </select>

      <noscript>
        <button
          type="submit"
          class="type-body-sm rounded-full px-6 py-3 font-medium text-white"
          style="background: var(--accent-blue)"
        >
          Buscar
        </button>
      </noscript>
    </form>

    <p class="type-body-sm mb-8" role="status" aria-live="polite" data-search-count style="color: var(--text-secondary)">
      {articles.length} matérias nesta edição
    </p>

    <div
      class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3"
      data-search-results
    >
      {
        docs.map(({ article, haystack }) => (
          <div data-haystack={haystack} data-category={article.category}>
            <ArticleCard article={article} headingLevel={2} />
          </div>
        ))
      }
    </div>

    <div class="hidden py-20 text-center" data-search-empty>
      <p class="type-body mb-2" style="color: var(--text-primary)">Nenhuma matéria encontrada.</p>
      <p class="type-body-sm mb-6" style="color: var(--text-muted)">
        Tente outro termo ou veja todas as editorias da edição.
      </p>
      <button
        type="button"
        class="type-body-sm rounded-full px-6 py-2.5 font-medium text-white transition-opacity hover:opacity-90"
        style="background: var(--accent-blue)"
        data-search-clear
      >
        Limpar busca
      </button>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-search-form]");
  const input = document.querySelector<HTMLInputElement>("[data-search-input]");
  const select = document.querySelector<HTMLSelectElement>("[data-search-category]");
  const countEl = document.querySelector<HTMLElement>("[data-search-count]");
  const empty = document.querySelector<HTMLElement>("[data-search-empty]");
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-haystack]"));

  const strip = (v: string) =>
    v.normalize("NFD").replace(/\p{Diacritic}/gu, "").toLowerCase().trim();

  function apply() {
    const q = strip(input?.value ?? "");
    const cat = select?.value ?? "";

    // O contador vem DESTE laço. Não existe segunda contagem que possa divergir.
    let visible = 0;
    for (const card of cards) {
      const matchQ = !q || (card.dataset.haystack ?? "").includes(q);
      const matchCat = !cat || card.dataset.category === cat;
      const show = matchQ && matchCat;
      card.hidden = !show;
      if (show) visible += 1;
    }

    if (countEl) {
      const noun = visible === 1 ? "matéria encontrada" : "matérias encontradas";
      countEl.textContent = q || cat ? `${visible} ${noun}` : `${visible} matérias nesta edição`;
    }
    empty?.classList.toggle("hidden", visible > 0);

    // Mantém a URL compartilhável sem recarregar a página.
    const params = new URLSearchParams();
    if (q) params.set("q", input?.value.trim() ?? "");
    if (cat) params.set("categoria", cat);
    const qs = params.toString();
    history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
  }

  // Estado inicial vindo da URL (links compartilhados funcionam).
  const initial = new URLSearchParams(location.search);
  if (input && initial.get("q")) input.value = initial.get("q") ?? "";
  if (select && initial.get("categoria")) select.value = initial.get("categoria") ?? "";

  form?.addEventListener("submit", (e) => e.preventDefault());
  input?.addEventListener("input", apply);
  select?.addEventListener("change", apply);
  document.querySelector("[data-search-clear]")?.addEventListener("click", () => {
    if (input) input.value = "";
    if (select) select.value = "";
    apply();
    input?.focus();
  });

  apply();
</script>
