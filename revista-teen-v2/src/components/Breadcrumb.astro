---
/**
 * Breadcrumb com dados estruturados (BreadcrumbList), que o Google usa para
 * montar a trilha no resultado de busca.
 */
export interface Crumb {
  label: string;
  href?: string;
}

export interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, Astro.site).href } : {}),
  })),
};
---

<nav aria-label="Você está aqui" class="type-caption flex flex-wrap items-center gap-2" style="color: var(--text-muted)">
  {
    items.map((item, i) => (
      <>
        {i > 0 && <span aria-hidden="true">›</span>}
        {item.href ? (
          <a href={item.href} class="underline-grow transition-colors hover:text-[var(--text-secondary)]">
            {item.label}
          </a>
        ) : (
          <span aria-current="page" style="color: var(--text-secondary)">
            {item.label}
          </span>
        )}
      </>
    ))
  }
</nav>

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
