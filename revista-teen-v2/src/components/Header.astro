---
/**
 * Header - navegação principal.
 *
 * A lista de editorias vem do content layer, nunca de um array escrito à mão.
 * Header, home, rodapé e páginas de categoria consomem exatamente a mesma fonte.
 * O menu usa ~20 linhas de JS puro (sem framework) para abrir/fechar.
 */
import { categories } from "@/lib/content";

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));

const links = [
  { href: "/", label: "Home" },
  { href: "/artigos", label: "Artigos" },
  { href: "/eventos", label: "Agenda" },
];
---

<header
  class="sticky top-0 z-50 h-16 border-b backdrop-blur-xl"
  style="background: color-mix(in srgb, var(--bg-primary) 90%, transparent); border-color: var(--border-subtle);"
>
  <div class="container-rt flex h-full items-center justify-between gap-4">
    <a href="/" class="glitch-hover flex items-center gap-2" aria-label="Revista Teen, página inicial">
      <span class="text-lg" style="color: var(--accent-blue)" aria-hidden="true">✦</span>
      <span class="font-display text-lg font-bold tracking-tight" style="color: var(--text-primary)">
        Revista Teen
      </span>
    </a>

    <!-- Navegação desktop -->
    <nav class="hidden items-center gap-7 md:flex" aria-label="Navegação principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="underline-grow type-body-sm font-medium transition-colors"
            style={`color: ${isActive(link.href) ? "var(--accent-blue)" : "var(--text-secondary)"}`}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }

      <!-- Editorias: <details> nativo = acessível por teclado sem JS -->
      <details class="relative" data-editorias>
        <summary
          class="underline-grow type-body-sm flex list-none items-center gap-1 font-medium transition-colors marker:hidden"
          style={`color: ${path.startsWith("/categoria") ? "var(--accent-blue)" : "var(--text-secondary)"}`}
        >
          Editorias
          <span aria-hidden="true" class="text-[10px]">▾</span>
        </summary>
        <div
          class="absolute right-0 top-full mt-3 grid max-h-[70vh] w-[min(30rem,85vw)] grid-cols-2 gap-1 overflow-y-auto rounded-2xl border p-3 shadow-2xl"
          style="background: var(--bg-surface); border-color: var(--border-subtle);"
        >
          {
            categories.map((cat) => (
              <a
                href={cat.href}
                class="flex items-center justify-between gap-2 rounded-lg px-3 py-2 transition-colors hover:bg-[var(--bg-elevated)]"
              >
                <span class="type-body-sm flex items-center gap-2" style="color: var(--text-secondary)">
                  <span class="h-2 w-2 shrink-0 rounded-full" style={`background:${cat.color}`} aria-hidden="true" />
                  {cat.name}
                </span>
                <span class="type-caption" style="color: var(--text-muted)">{cat.count}</span>
              </a>
            ))
          }
        </div>
      </details>
    </nav>

    <div class="flex items-center gap-1">
      <a
        href="/busca"
        class="rounded-lg p-2 transition-colors hover:bg-[var(--bg-elevated)]"
        style="color: var(--text-muted)"
        aria-label="Buscar artigos"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
      </a>

      <button
        type="button"
        class="rounded-lg p-2 transition-colors hover:bg-[var(--bg-elevated)] md:hidden"
        style="color: var(--text-muted)"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="menu-mobile"
        data-menu-toggle
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Menu mobile -->
<div id="menu-mobile" class="fixed inset-0 z-[60] hidden md:hidden" data-menu-panel>
  <div class="absolute inset-0" style="background: var(--bg-overlay)" data-menu-close aria-hidden="true"></div>
  <nav
    class="absolute right-0 top-0 bottom-0 w-[min(20rem,85vw)] overflow-y-auto border-l p-6"
    style="background: var(--bg-surface); border-color: var(--border-subtle);"
    aria-label="Menu"
  >
    <button
      type="button"
      class="absolute right-4 top-4 rounded-lg p-2 hover:bg-[var(--bg-elevated)]"
      style="color: var(--text-muted)"
      aria-label="Fechar menu"
      data-menu-close
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>

    <p class="type-overline mb-4 mt-2" style="color: var(--text-muted)">Navegação</p>
    <ul class="mb-8 space-y-1">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="type-body-sm block rounded-lg px-4 py-3 font-medium transition-colors hover:bg-[var(--bg-elevated)]"
              style={`color: ${isActive(link.href) ? "var(--accent-blue)" : "var(--text-secondary)"}`}
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="/busca"
          class="type-body-sm block rounded-lg px-4 py-3 font-medium transition-colors hover:bg-[var(--bg-elevated)]"
          style="color: var(--text-secondary)"
        >
          Buscar
        </a>
      </li>
    </ul>

    <p class="type-overline mb-4" style="color: var(--text-muted)">Editorias</p>
    <ul class="space-y-1">
      {
        categories.map((cat) => (
          <li>
            <a
              href={cat.href}
              class="type-body-sm flex items-center justify-between gap-3 rounded-lg px-4 py-2.5 transition-colors hover:bg-[var(--bg-elevated)]"
              style="color: var(--text-secondary)"
            >
              <span class="flex items-center gap-3">
                <span class="h-2 w-2 shrink-0 rounded-full" style={`background:${cat.color}`} aria-hidden="true" />
                {cat.emoji} {cat.name}
              </span>
              <span class="type-caption" style="color: var(--text-muted)">{cat.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");

  function setOpen(open: boolean) {
    if (!panel || !toggle) return;
    panel.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
  }

  toggle?.addEventListener("click", () => setOpen(panel?.classList.contains("hidden") ?? true));
  document.querySelectorAll("[data-menu-close]").forEach((el) => el.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  // Fecha o dropdown de editorias ao clicar fora.
  const dropdown = document.querySelector<HTMLDetailsElement>("[data-editorias]");
  document.addEventListener("click", (e) => {
    if (dropdown?.open && !dropdown.contains(e.target as Node)) dropdown.open = false;
  });
</script>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
