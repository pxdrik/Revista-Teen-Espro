---
/**
 * Aviso de cookies (LGPD). O público tem menores de idade, então o Google Analytics só
 * carrega depois do "Aceitar": sem escolha, ou com "Recusar", nenhum cookie do Google.
 * A escolha fica neste navegador; o link "Cookies" do rodapé reabre o aviso.
 *
 * Só o deploy de produção da Vercel carrega a tag: dev e previews mostram o aviso, mas
 * não contam visita.
 */
const comAnalytics = process.env.VERCEL_ENV === "production";
---

<div id="cookies" class="cookies" role="region" aria-label="Aviso de cookies" hidden>
  <p class="type-body-sm">
    Usamos cookies do Google Analytics só para contar as visitas e saber quais matérias
    vocês mais leem. Nada de anúncio. Você aceita?
  </p>
  <div class="cookies-acoes">
    <button type="button" data-cookies="recusado">Recusar</button>
    <button type="button" data-cookies="aceito" class="cookies-aceitar">Aceitar</button>
  </div>
</div>

<style>
  .cookies {
    position: fixed;
    inset: auto 16px calc(16px + env(safe-area-inset-bottom, 0px)) 16px;
    z-index: 60;
    max-width: 560px;
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    padding: 16px 20px;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-elevated);
    color: var(--text-secondary);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.5);
  }
  .cookies[hidden] { display: none; }
  .cookies p { flex: 1 1 260px; margin: 0; }
  .cookies-acoes { display: flex; gap: 8px; }
  .cookies button {
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--border-subtle);
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
  }
  .cookies button:focus-visible { outline: 2px solid var(--accent-blue); outline-offset: 2px; }
  .cookies .cookies-aceitar { background: var(--accent-blue); border-color: var(--accent-blue); color: #fff; }
</style>

<script is:inline define:vars={{ comAnalytics }}>
  (function () {
    var CHAVE = "rt-cookies";
    var aviso = document.getElementById("cookies");
    var ler = function () { try { return localStorage.getItem(CHAVE); } catch (e) { return null; } };
    var gravar = function (v) { try { localStorage.setItem(CHAVE, v); } catch (e) {} };
    function carregarAnalytics() {
      if (!comAnalytics || window.gtag) return;
      var s = document.createElement("script");
      s.async = true;
      s.src = "https://www.googletagmanager.com/gtag/js?id=G-RZX972NG8R";
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag("js", new Date());
      window.gtag("config", "G-RZX972NG8R");
    }
    var escolha = ler();
    if (escolha === "aceito") carregarAnalytics();
    else if (escolha !== "recusado") aviso.hidden = false;

    document.addEventListener("click", function (e) {
      var alvo = e.target.closest("[data-cookies]");
      if (!alvo) return;
      var v = alvo.getAttribute("data-cookies");
      if (v === "abrir") { aviso.hidden = false; return; }
      gravar(v);
      aviso.hidden = true;
      if (v === "aceito") carregarAnalytics();
      else {
        // Quem recusa depois de aceitar: apaga os cookies _ga e recarrega sem a tag.
        document.cookie.split(";").forEach(function (c) {
          var nome = c.split("=")[0].trim();
          if (nome.indexOf("_ga") !== 0) return;
          document.cookie = nome + "=; Max-Age=0; path=/";
          document.cookie = nome + "=; Max-Age=0; path=/; domain=." + location.hostname;
        });
        if (window.gtag) location.reload();
      }
    });
  })();
</script>
